// WyrmWoodWilds - relaxed structural stability + tiered integrity.
// VerticalLoss/HorizontalLoss = 0 means pieces keep their MaxStability instead
// of decaying with distance/height (no red support, no natural collapse).
// MaxStability is also raised per tier to match the requested integrity bump:
//   T1 x2, T2 x3, T3 x4 (T4 pieces reuse the T3 profile in this build).
// MinStability is untouched.
{
  "/Game/Gameplay/BaseBuilding_New/DT_StabilityProfile.DT_StabilityProfile": {
    "Prop":                { "VerticalLoss": 0.0, "HorizontalLoss": 0.0 },
    "Stackable_Prop":      { "VerticalLoss": 0.0, "HorizontalLoss": 0.0 },
