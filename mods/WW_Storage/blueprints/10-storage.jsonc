// WyrmWoodWilds - larger storage.
// Values are slot counts. Vanilla: Crate 16, Small 32, Chest 48, Iron 64,
// Personal 40, Lumber 48, Ore 48, Fishing rack 4.
// Policy: one tier = one extra row and column.
// Crate 12x9, Small 13x10, Chest 14x11, Iron 15x12, Personal 16x13.
// 16x13 = 208 is the largest grid that fits beside the player panel at normal
// slot size on a 16:9 screen; UI scales with resolution so the grid is the same
// at 1440p/4K.
{
  "/Game/Gameplay/BaseBuilding/Actors/Props/BP_BaseBuilding_Crate.BP_BaseBuilding_Crate_C": {
    "BP_Components_WorldItemInventory": {
      "MaxSlotCount": 108,
      "bSupportsSortAndFillStacks": true
    }
  },
